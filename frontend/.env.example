VITE_API_URL=http://localhost:8000

# Google Maps JavaScript API key for the booking page's location picker
# (components/Booking/LocationPicker.tsx). Optional — if unset, the map
# shows a graceful "unable to load" fallback and the rest of the booking
# form (including "Use My Current Location") still works normally.
# Restrict this key to your site's domain(s) in Google Cloud Console before
# using a real one — a browser-side Maps key is public by nature.
VITE_GOOGLE_MAPS_API_KEY=
