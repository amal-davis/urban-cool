# Copy to .env and fill in for local development. .env is gitignored.

DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL/MariaDB — defaults match XAMPP's out-of-the-box root/no-password
# local setup. Create the database yourself first (e.g. via phpMyAdmin);
# `manage.py migrate` creates the tables inside it, not the database itself.
DB_NAME=urbancool
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# OTP auth (accounts app) — defaults live in config/settings.py; uncomment
# to override.
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN_SECONDS=45
# OTP_MAX_ATTEMPTS=5

# Email (Gmail SMTP) — notification emails (booking confirmations,
# technician <-> customer status updates, admin/technician alerts) send
# through this account. Use an app password (Google Account > Security >
# App passwords), not the account's real login password — Gmail rejects
# SMTP auth with the real password once 2FA is on, which it must be to
# generate an app password at all. Leave both unset to fall back to
# Django's console backend (prints emails to the runserver terminal instead
# of sending them — the default so a fresh checkout doesn't need real
# credentials just to run migrations/tests).
# EMAIL_HOST_USER=your-account@gmail.com
# EMAIL_HOST_PASSWORD=your16charapppassword
